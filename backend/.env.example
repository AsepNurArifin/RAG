# ============================================
# EnterpriseMind AI — Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# JANGAN PERNAH commit file .env ke git!
# ============================================

# --- LLM Provider (Google Gemini 2.5 Flash) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- PostgreSQL (Local) ---
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/enterprisemind

# --- Milvus Vector DB (Docker) ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprisemind_documents

# --- Docling Document Ingestion (Docker Serve) ---
DOCLING_URL=http://localhost:5001

# --- Temporal (Docker) ---
TEMPORAL_HOST=localhost:7233

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- JWT Authentication ---
JWT_SECRET_KEY=generate-dengan-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480

# --- MinIO Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=enterprisemind-docs

