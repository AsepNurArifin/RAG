# ============================================
# EnterpriseMind AI — Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# JANGAN PERNAH commit file .env ke git!
# ============================================

# --- LLM Provider (Groq) ---
GROQ_API_KEY=gsk_your_key_here_get_from_console_groq_com
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile

# --- PostgreSQL (Local) ---
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/enterprisemind

# --- Milvus Vector DB (Docker) ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprisemind_documents

# --- Docling Document Ingestion (Docker Serve) ---
DOCLING_URL=http://localhost:5001

# --- Temporal (Docker) ---
TEMPORAL_HOST=localhost:7233

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
EXTRACTION_TIMEOUT_SECONDS=600

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- JWT Authentication ---
# Wajib diganti di production: openssl rand -hex 32
JWT_SECRET_KEY=generate-dengan-openssl-rand-hex-32-MUST-CHANGE-IN-PROD
JWT_EXPIRE_MINUTES=480

# --- MinIO Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=enterprisemind-docs

