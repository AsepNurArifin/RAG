# ============================================
# EnterpriseMind AI — Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# JANGAN PERNAH commit file .env ke git!
# ============================================

# --- LLM Provider (Groq) ---
GROQ_API_KEY=gsk_your_key_here_get_from_console_groq_com
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASONING=openai/gpt-oss-120b

# --- LLM Token Cost (USD per 1M tokens) ---
# Digunakan untuk estimasi biaya query di query_logs & dashboard.
LLM_INPUT_COST_PER_MILLION_TOKENS=0.25
LLM_OUTPUT_COST_PER_MILLION_TOKENS=0.80

# --- PostgreSQL (Local) ---
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/enterprisemind
# --- PostgreSQL (Docker — driver docker-compose.yml) ---
# WAJIB sinkron dengan DATABASE_URL di atas. Di production TIDAK boleh default.
POSTGRES_PASSWORD=your_strong_password_here

# --- MinIO (Docker — service milvus-minio, dipakai juga untuk document storage) ---
# Di production WAJIB di-set kuat. Default docker-compose: minioadmin/minioadmin.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_strong_secret

# --- Temporal (Docker) ---
# Fase 0: Temporal memakai postgres-app, jadi TEMPORAL_PASSWORD tidak dipakai lagi.
# Password database mengikuti POSTGRES_PASSWORD di atas.

# --- Milvus Vector DB (Docker) ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprisemind_documents

# --- Docling (OPSIONAL — Fase 2: OFF di VPS) ---
# Default OFF: ekstraksi tabel native PyMuPDF. Nyalakan hanya untuk backfill
# dokumen bertabel kompleks via Docling eksternal (docker run -p 5001:5001 ...).
DOCLING_ENABLED=false
DOCLING_URL=http://localhost:5001

# --- Temporal (Docker) ---
# Fase 0: Temporal memakai database postgres-app (POSTGRES_PASSWORD di atas).
TEMPORAL_HOST=localhost:7233

# --- Embedding Model ---
# Fase 3A/3B: EMBEDDING_BACKEND / RERANKER_BACKEND default "onnx" (runtime
# ringan). Mode "pytorch" memakai sentence-transformers (berat, hanya untuk
# fallback/ekspor saat berkas ONNX belum tersedia).
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
EXTRACTION_TIMEOUT_SECONDS=600

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- JWT Authentication ---
# WAJIB di-set di semua environment (termasuk development).
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=generate-dengan-openssl-rand-hex-32-MUST-CHANGE-IN-PROD
JWT_EXPIRE_MINUTES=480

# --- Bootstrap Admin (opsional, hanya untuk deployment fresh) ---
# Jika kedua variable diset, admin pertama dibuat saat startup.
# JANGAN disimpan di git. Set hanya di environment runtime.
# BOOTSTRAP_ADMIN_EMAIL=admin@company.com
# BOOTSTRAP_ADMIN_PASSWORD=password-kuat-minimal-12-karakter

# --- Conversation History ---
CONVERSATION_HISTORY_LIMIT=5
CONVERSATION_HISTORY_MAX_CHARS=200

# --- Observability (LangFuse) — OPTIONAL, NON-CRITICAL ---
# Jika diaktifkan tapi gagal, query TETAP berjalan.
# LangFuse Cloud: buat project di https://cloud.langfuse.com
# lalu isi Public Key (pk-lf-...) dan Secret Key (sk-lf-...).
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Tools ---
# NOTE: Web search (Tavily) DILARANG untuk PT internal — tidak tersedia.
ENABLE_CALCULATOR=true
ENABLE_METADATA_TOOL=true

# --- MinIO Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=enterprisemind-docs

# --- Deploy (Fase 1: image di-pull dari GHCR, build dilakukan di CI) ---
# BACKEND_IMAGE dipakai backend & worker di docker-compose.prod.yml.
# Ganti <owner> dengan nama akun GitHub pemilik repository.
# BACKEND_IMAGE=ghcr.io/<owner>/enterprisemind-backend
# IMAGE_TAG=latest        # deploy immutable: IMAGE_TAG=<git-sha>

