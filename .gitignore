# ============================================
# EnterpriseMind AI â€” Root .gitignore
# ============================================

# Environment & secrets â€” CRITICAL: never commit!
.env
.env.*
!.env.example

# Node / Frontend
node_modules/
.next/
out/
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# Chroma persistent storage
chroma_db/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
htmlcov/
.coverage
.xml.coverage

# Distribution
dist/
build/
*.egg-info/

# Logs
*.log

# Docker
docker-compose.override.yml

# Vercel
.vercel

# Misc
*.tmp
*.bak

# ============================================
# Project-specific
# ============================================

# --- Secrets & credentials (redundan, jaga-jaga) ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
*.secret
!cacert.pem

# --- Dokumen internal / materi training (SANGAT SENSITIF, PT) ---
# Jangan commit dokumen asli milik perusahaan ke repo publik.
docs/
*.pdf
*.pptx
*.docx
*.xlsx

# --- Dokumentasi internal (.md) â€” HANYA README yang boleh di-commit ---
# Dokumentasi arsitektur/planning adalah catatan internal, tidak untuk publik.
*.md
!README.md
!backend/README.md
!frontend/README.md

# --- Graphify output (berisi cuplikan isi dokumen + cache) ---
graphify-out/

# --- Diagram / artefak hasil generate (review dulu sebelum commit) ---
output*.png

# --- Debug/test scripts (dibuat saat development) ---
backend/test_*.py
backend/diag_test.py
backend/test_debug_pipeline.py
backend/test_hybrid_extractor.py
backend/test_pipeline.py

# --- User uploads ---
backend/uploads/

# --- Chroma local (jika persist ke disk) ---
backend/chroma_db/

# --- Milvus / Temporal local data ---
milvus_data/
temporal_data/

# --- Tool lokasi bundle mudah bocor (jika ada di masa depan) ---
*.log.*
.DS_Store
Thumbs.db


# Playwright MCP artifacts
.playwright-mcp/

# Session & HTML artifacts
*.html
pi-session-*

